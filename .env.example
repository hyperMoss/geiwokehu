# Python 环境需安装 vendor/mediacrawler/requirements.txt 和 Playwright Chromium。
MEDIACRAWLER_PYTHON=/absolute/path/to/python-with-crawler-dependencies
DOUYIN_ACCOUNT_COOKIE=
XHS_ACCOUNT_COOKIE=
CRAWLER_HOST=127.0.0.1
CRAWLER_PORT=8765
CRAWLER_API_URL=http://127.0.0.1:8765
# 可选：仅在潜客页手动点击“AI 分析”时使用，绝不填入 NEXT_PUBLIC_ 变量。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
